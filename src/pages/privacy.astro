---
import Base from '../layouts/Base.astro';

const summary = [
  {
    what: 'Nothing, as you browse',
    why: 'There is no analytics script, no cookie, no tracker',
    whoSees: 'Nobody',
    howToDelete: 'Nothing to delete',
  },
  {
    what: 'Standard server logs',
    why: 'The hosting provider serves the pages',
    whoSees: 'Netlify, transiently, as with any host',
    howToDelete: 'Expires automatically per their retention policy',
  },
  {
    what: 'Your email, if you ask for a launch note',
    why: "The notify-me field on an unreleased game's page",
    whoSees: 'Netlify stores the submission; the founder reads it',
    howToDelete: 'Email and ask, any time before or after launch',
  },
  {
    what: 'Email you choose to send',
    why: 'Because you wrote in',
    whoSees: 'The one person who answers it',
    howToDelete: 'Ask in the same thread; it gets deleted',
  },
];
---

<Base
  title="Site Privacy - Nattskift Games"
  description="The site privacy policy in plain language: no cookies, no analytics, no trackers, self-hosted fonts. One optional launch-notify email field, explained honestly."
  ogImage="/og/privacy.png"
>
  <section class="section-pad">
    <div class="mx-auto max-w-6xl px-6">
      <h1 class="type-page-title">Site privacy</h1>
      <p class="type-micro mt-4 text-muted">
        Last updated <time datetime="2026-08-31">2026-08-31</time>
      </p>

      <h2 class="type-section mt-16">The short version</h2>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[640px] text-left">
          <thead>
            <tr class="border-b border-hairline">
              <th scope="col" class="type-label py-3 pr-6 font-medium text-muted">What</th>
              <th scope="col" class="type-label py-3 pr-6 font-medium text-muted">Why</th>
              <th scope="col" class="type-label py-3 pr-6 font-medium text-muted">Who sees it</th>
              <th scope="col" class="type-label py-3 font-medium text-muted">How to delete it</th>
            </tr>
          </thead>
          <tbody>
            {
              summary.map((row) => (
                <tr class="border-b border-hairline align-top">
                  <th scope="row" class="py-4 pr-6 font-medium text-text">{row.what}</th>
                  <td class="py-4 pr-6 text-muted">{row.why}</td>
                  <td class="py-4 pr-6 text-muted">{row.whoSees}</td>
                  <td class="py-4 text-muted">{row.howToDelete}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="border-t border-hairline section-pad">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="type-section">The full policy</h2>
      <div class="measure mt-8 space-y-4 text-muted">
        <p>
          This site is static files. It sets no cookies, runs no analytics,
          loads no third-party scripts, and hosts its own fonts. There is no
          account system, and browsing collects nothing. The one thing the
          site can collect is described below, and it only happens if you
          type it in yourself.
        </p>
        <p>
          Unreleased games have a notify-me field. If you enter your email
          there, Netlify (the company that hosts this site) stores the
          submission, and it is used to send exactly one email when that
          game launches. No newsletter grows out of it, and the address is
          not shared or used for anything else. To be taken off the list
          before launch — or to have the address deleted after — email the
          studio and it gets removed by hand.
        </p>
        <p>
          The pages are served by Netlify, which — like any host —
          processes IP addresses in transient server logs to deliver the
          site and absorb abuse. The studio does not access or export those
          logs.
        </p>
        <p>
          If you email the studio, your email exists in a mailbox until the
          thread is done. Ask for it to be deleted and it will be, by the
          person you were talking to.
        </p>
        <p>
          Each game has its own policy, linked in the footer, and they are
          just as short for the same reason: the games don't collect data
          either.
        </p>
      </div>
      <p class="measure mt-12 border-t border-hairline pt-8 text-muted">
        Questions:
        <a class="link-quiet" href="mailto:info@nattskiftgames.com?subject=Data%20request">
          info@nattskiftgames.com</a>
      </p>
    </div>
  </section>
</Base>
