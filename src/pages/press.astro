---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';

const games = (await getCollection('games')).sort(
  (a, b) => a.data.order - b.data.order,
);

const studioFacts: Array<[string, string]> = [
  ['Studio', 'Nattskift Games'],
  ['Founded', '2024'],
  ['Location', 'Los Angeles, California'],
  ['Team size', 'One'],
  ['Platform', 'iOS'],
  ['Titles', games.map((g) => g.data.title).join(', ')],
  ['Contact', 'press@nattskift.games'],
];
---

<Base
  title="Press - Nattskift Games"
  description="Press kit for Nattskift Games: studio fact sheet, direct asset downloads, and per-game details for Last Light and Trash Games Factory. No form, no gate."
>
  <section class="section-pad">
    <div class="mx-auto max-w-6xl px-6">
      <h1 class="type-page-title">Press</h1>
      <p class="type-lead measure mt-6 text-muted">
        Everything on this page downloads directly. No form, no gate, no
        "request access."
      </p>

      <h2 class="type-section mt-16">Fact sheet</h2>
      <table class="mt-8 w-full max-w-2xl font-mono text-[13px] leading-relaxed">
        <tbody>
          {
            studioFacts.map(([label, value]) => (
              <tr class="border-b border-hairline">
                <th scope="row" class="py-3 pr-8 text-left font-normal text-muted">{label}</th>
                <td class="py-3 text-text">{value}</td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <h2 class="type-section mt-16">Studio assets</h2>
      <ul class="mt-8 space-y-3">
        <li>
          <a class="link-quiet" href="/favicon.svg" download="nattskift-monogram.svg">
            Monogram mark (SVG)
          </a>
        </li>
      </ul>
      <p class="type-caption measure mt-4 text-muted">
        The full wordmark lockup renders with the site's licensed webfont;
        email for a flattened vector version and it arrives as an attachment,
        not a link to a portal.
      </p>

      <h2 class="type-section mt-16">Review copies</h2>
      <p class="measure mt-6 text-muted">
        Writing about either game? Email
        <a class="link-quiet" href="mailto:press@nattskift.games">press@nattskift.games</a>
        from a public masthead address and a promo code comes back, usually
        the same night.
      </p>
    </div>
  </section>

  {
    games.map((game) => (
      <section id={game.id} class="border-t border-hairline section-pad">
        <div class="mx-auto max-w-6xl px-6">
          <h2 class="type-section">{game.data.title}</h2>
          <p class="measure mt-6 text-muted">{game.data.press.blurb}</p>

          <table class="mt-10 w-full max-w-2xl font-mono text-[13px] leading-relaxed">
            <tbody>
              {game.data.press.facts.map((fact) => (
                <tr class="border-b border-hairline">
                  <th scope="row" class="py-3 pr-8 text-left font-normal text-muted">{fact.label}</th>
                  <td class="py-3 text-text">{fact.value}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <h3 class="type-subsection mt-12">Assets</h3>
          <ul class="mt-6 space-y-3">
            <li>
              <a
                class="link-quiet"
                href={game.data.keyArt.src.src}
                download={`${game.id}-key-art.svg`}
              >
                Key art ({game.data.keyArt.src.width}x{game.data.keyArt.src.height})
              </a>
            </li>
            {game.data.screenshots.map((shot, i) => (
              <li>
                <a class="link-quiet" href={shot.src.src} download={`${game.id}-screen-${i + 1}.svg`}>
                  Screenshot {i + 1} ({shot.src.width}x{shot.src.height})
                </a>
              </li>
            ))}
          </ul>

          <div class="mt-12 max-w-xl">
            <Image
              src={game.data.keyArt.src}
              alt={game.data.keyArt.alt}
              widths={[576, 1152]}
              sizes="(min-width: 768px) 576px, 100vw"
              class="card w-full"
            />
          </div>
        </div>
      </section>
    ))
  }
</Base>
