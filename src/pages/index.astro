---
import Base from '../layouts/Base.astro';
---

<Base
  title="Nattskift Games - iOS games made on the night shift"
  description="Nattskift Games is one person in Los Angeles making iOS games that are finished when they ship, free to start, and honest about what they cost."
>
  <section class="section-pad">
    <div class="mx-auto max-w-6xl px-6">
      <h1 class="type-hero">Made on the night shift.</h1>
      <p class="type-lead measure mt-6 text-muted">
        Homepage lands in the next phase. This page exists so the scaffold
        builds end to end.
      </p>
    </div>
  </section>
</Base>
