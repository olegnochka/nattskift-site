---
import Base from '../layouts/Base.astro';
---

<Base
  title="You're on the list - Nattskift Games"
  description="Thanks for signing up. One email at launch, nothing else."
>
  <section class="mx-auto max-w-3xl px-6 py-24 text-center md:py-32">
    <h1 class="type-page-title" data-reveal>You're on the list.</h1>
    <p class="type-lead mt-4 text-muted" data-reveal style="--reveal-index: 1">
      One email when the game launches. No newsletter, no follow-ups, no
      "we miss you". That's the whole deal.
    </p>
    <p class="mt-10" data-reveal style="--reveal-index: 2">
      <a href="/games/" class="btn-primary">Back to the games</a>
    </p>
  </section>
</Base>
