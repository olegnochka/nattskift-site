---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GameCard from '../../components/GameCard.astro';
import InProgressCard from '../../components/InProgressCard.astro';

const games = (await getCollection('games')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="Games - Nattskift Games"
  description="Four iOS games from a one-person studio in Los Angeles: Hunch, a daily logic puzzle, Golden Party Casino, Last Light, and Trash Games Factory. No ads, ever."
  ogImage="/og/games.png"
>
  <section class="section-pad">
    <div class="mx-auto max-w-6xl px-6">
      <h1 class="type-page-title" data-reveal>The games</h1>
      <p class="type-lead measure mt-6 text-muted" data-reveal style="--reveal-index: 1">
        Four titles, all iOS, all built by one person. Free to try, priced in
        real money, finished before they ship.
      </p>
      <div class="mt-16 grid gap-8 md:grid-cols-2">
        {
          games.map((game, i) => (
            <div data-reveal style={`--reveal-index: ${i + 2}`}>
              <GameCard game={game} />
            </div>
          ))
        }
        {games.length % 2 !== 0 && (
          <div data-reveal style={`--reveal-index: ${games.length + 2}`}>
            <InProgressCard />
          </div>
        )}
      </div>
    </div>
  </section>
</Base>
