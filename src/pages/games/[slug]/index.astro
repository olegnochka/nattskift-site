---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import AppStoreBadge from '../../../components/AppStoreBadge.astro';
import Trailer from '../../../components/Trailer.astro';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.map((game) => ({ params: { slug: game.id }, props: { game } }));
}

interface Props {
  game: CollectionEntry<'games'>;
}
const { game } = Astro.props;
const g = game.data;

const site = Astro.site!.origin;

const factRows: Array<[string, string]> = [
  ['Platform', g.facts.platform],
  ['Minimum iOS', g.facts.minimumOS],
  ['Size', g.facts.size],
  ['Languages', g.facts.languages],
  ['Release date', g.facts.releaseDate],
  ['Price', g.facts.price],
  ['Engine', g.facts.engine],
  ['Developer', g.facts.developer],
];

---

<Base
  title={g.seo.title}
  description={g.seo.description}
  ogImage={`/og/${game.id}.png`}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: g.title,
    operatingSystem: 'iOS',
    applicationCategory: 'GameApplication',
    description: g.seo.description,
    url: `${site}/games/${game.id}`,
    image: `${site}/og/${game.id}.png`,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    author: {
      '@type': 'Organization',
      name: 'Nattskift Games',
      url: site,
    },
    datePublished: g.facts.releaseDate,
    softwareVersion: g.latestUpdate.version,
  }}
>
  <meta slot="head" name="apple-itunes-app" content={`app-id=${g.appStoreId}`} />

  {/* body paints its background AFTER negative-z children, which would hide
      the ambient layer - so on game pages the body goes transparent and the
      identically-colored html background takes over. */}
  <style is:global>
    body { background-color: transparent; }
  </style>
  {g.pageBackground && (
    <div class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true">
      <Image
        src={g.pageBackground}
        alt=""
        widths={[1280, 1920]}
        sizes="100vw"
        class="h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-black/55"></div>
    </div>
  )}

  {/* 1 — Hero: full-bleed key art, then the essentials. */}
  <section>
    <Image
      src={g.keyArt.src}
      alt={g.keyArt.alt}
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="max-h-[70vh] w-full object-cover"
    />
    <div class="mx-auto max-w-6xl px-6 py-12 md:py-16">
      <h1 class="type-page-title" data-reveal>{g.title}</h1>
      <p class="type-lead mt-3 text-muted" data-reveal style="--reveal-index: 1">{g.hook}</p>
      <div class="mt-8 flex flex-wrap items-center gap-4" data-reveal style="--reveal-index: 2">
        <AppStoreBadge appStoreId={g.appStoreId} title={g.title} />
        <span class="tag">{g.tags.price}</span>
      </div>
    </div>
  </section>

  {/* 2 — Pitch. */}
  <section class="border-t border-hairline section-pad">
    <div class="mx-auto max-w-6xl px-6" data-reveal>
      <h2 class="type-label text-muted">The pitch</h2>
      <p class="type-lead measure mt-6">{g.pitch}</p>
    </div>
  </section>

  {/* 3 — Trailer. */}
  {
    g.trailer && (
      <section class="border-t border-hairline section-pad">
        <div class="mx-auto max-w-6xl px-6" data-reveal>
          <h2 class="type-label text-muted">Trailer</h2>
          <div class="mt-8">
            <Trailer
              poster={g.trailer.poster}
              posterAlt={g.trailer.posterAlt}
              embedUrl={g.trailer.embedUrl}
              title={g.title}
            />
          </div>
        </div>
      </section>
    )
  }

  {/* 4 — Three pillars. */}
  <section class="border-t border-hairline section-pad">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="type-label text-muted" data-reveal>How it plays</h2>
      <div class="mt-10 grid gap-12 md:grid-cols-3 md:gap-8">
        {
          g.pillars.map((pillar, i) => (
            <div data-reveal style={`--reveal-index: ${i}`}>
              <Image
                src={pillar.image}
                alt={pillar.alt}
                widths={[400, 800]}
                sizes="(min-width: 768px) 33vw, 100vw"
                class="card w-full"
              />
              <h3 class="type-subsection mt-6 text-text">{pillar.title}</h3>
              <p class="mt-3 text-muted">{pillar.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* 5 — Screenshots: raw device captures, no frames, no tilt. */}
  <section class="border-t border-hairline section-pad">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="type-label text-muted" data-reveal>Screens</h2>
      <div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-3 md:gap-6">
        {
          g.screenshots.map((shot, i) => (
            <div data-reveal style={`--reveal-index: ${i % 3}`}>
              <Image
                src={shot.src}
                alt={shot.alt}
                widths={[390, 780]}
                sizes="(min-width: 768px) 33vw, 50vw"
                class="card w-full"
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* 6 — The deal: monetization as a statement, not fine print. */}
  <section class="bg-royal section-pad">
    <div class="mx-auto max-w-6xl px-6 text-button-label" data-reveal>
      <h2 class="type-label opacity-80">The deal</h2>
      <div class="mt-10 grid gap-10 md:grid-cols-3">
        <div>
          <h3 class="type-subsection">What's free</h3>
          <p class="mt-3 max-w-[40ch]">{g.deal.free}</p>
        </div>
        <div>
          <h3 class="type-subsection">What's paid</h3>
          <p class="mt-3 max-w-[40ch]">{g.deal.paid}</p>
        </div>
        <div>
          <h3 class="type-subsection">What it costs</h3>
          <p class="mt-3 max-w-[40ch]">{g.deal.costs}</p>
        </div>
      </div>
      <ul class="mt-12 space-y-2 border-t border-[rgb(255_255_255/0.2)] pt-8">
        {g.deal.never.map((line) => <li class="max-w-[68ch]">{line}</li>)}
      </ul>
    </div>
  </section>

  {/* 7 — Facts. */}
  <section class="border-t border-hairline section-pad">
    <div class="mx-auto max-w-6xl px-6" data-reveal>
      <h2 class="type-label text-muted">Facts</h2>
      <table class="mt-8 w-full max-w-2xl font-mono text-[13px] leading-relaxed">
        <tbody>
          {
            factRows.map(([label, value]) => (
              <tr class="border-b border-hairline">
                <th scope="row" class="py-3 pr-8 text-left font-normal text-muted">
                  {label}
                </th>
                <td class="py-3 text-text">{value}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  {/* 8 — Latest update. */}
  <section class="border-t border-hairline section-pad">
    <div class="mx-auto max-w-6xl px-6" data-reveal>
      <h2 class="type-label text-muted">Latest update</h2>
      <p class="type-micro mt-6 text-muted">
        v{g.latestUpdate.version} — <time datetime={g.latestUpdate.date}>{g.latestUpdate.date}</time>
      </p>
      <ul class="mt-4 max-w-2xl space-y-2">
        {g.latestUpdate.changes.map((change) => (
          <li class="border-l-2 border-hairline pl-4 text-muted">{change}</li>
        ))}
      </ul>
    </div>
  </section>

  {/* 9 — Footer strip for this title. */}
  <section class="border-t border-hairline">
    <div class="mx-auto flex max-w-6xl flex-wrap gap-x-8 gap-y-3 px-6 py-10">
      <a class="link-quiet" href={`/games/${game.id}/support`}>{g.title} support</a>
      <a class="link-quiet" href={`/games/${game.id}/privacy`}>{g.title} privacy</a>
      <a class="link-quiet" href={`/press#${game.id}`}>Press assets</a>
    </div>
  </section>
</Base>
