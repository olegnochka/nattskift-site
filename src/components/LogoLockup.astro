---
/**
 * Primary lockup from the brand kit: the square split in half, NATTSKIFT on
 * the black half and GAMES on the violet half, both as outlined Slackey
 * paths. Outlines rather than live text, so it renders identically
 * everywhere with no webfont to load and no seam to tune.
 *
 * Single source of truth is src/assets/brand/wordmark.svg; the emblem-only
 * version for small sizes is LogoMonogram.astro.
 */
import wordmark from '../assets/brand/wordmark.svg?raw';

interface Props {
  /** Rendered size in px (square). */
  size?: number;
  class?: string;
}
const { size = 96, class: className } = Astro.props;
const svg = wordmark.replace(
  '<svg ',
  `<svg width="${size}" height="${size}" ${className ? `class="${className}" ` : ''}`,
);
---

<Fragment set:html={svg} />
