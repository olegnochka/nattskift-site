---
/**
 * Apple's official "Download on the App Store" badge (SVG in /public,
 * straight from Apple's marketing resources — do not restyle it).
 * Swap href's placeholder id for the real one when the app is live.
 */
interface Props {
  appStoreId: string;
  title: string;
  /** App Store campaign name (ct=), so App Analytics -> Campaigns shows which link a download came from. */
  campaign?: string;
}
const { appStoreId, title, campaign } = Astro.props;
// pt = the provider token of the Nattskift developer account (App Store Connect -> App Analytics ->
// Campaigns -> Generate a Campaign Link); the same for every app on the account.
const PROVIDER_TOKEN = '129294312';
const href = campaign
  ? `https://apps.apple.com/app/apple-store/id${appStoreId}?pt=${PROVIDER_TOKEN}&ct=${encodeURIComponent(campaign)}&mt=8`
  : `https://apps.apple.com/app/id${appStoreId}`;
---

<a href={href} class="inline-block" aria-label={`Download ${title} on the App Store`}>
  <img
    src="/app-store-badge.svg"
    alt=""
    width="180"
    height="60"
    class="h-[54px] w-auto"
    loading="lazy"
  />
</a>
