---
/**
 * Hand-built App Store link badge — inline SVG, no icon package.
 * Swap href's placeholder id for the real one when the app is live.
 */
interface Props {
  appStoreId: string;
  title: string;
}
const { appStoreId, title } = Astro.props;
const href = `https://apps.apple.com/app/id${appStoreId}`;
---

<a
  href={href}
  class="inline-flex items-center gap-3 rounded-control border border-hairline bg-surface px-5 py-3 hover:bg-raised"
  aria-label={`Download ${title} on the App Store`}
>
  {/* apple glyph */}
  <svg width="20" height="24" viewBox="0 0 20 24" aria-hidden="true" fill="currentColor" class="text-text">
    <path
      d="M16.4 12.8c0-2.4 2-3.6 2.1-3.7-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.8-1.6 0-3.2 1-4 2.4-1.7 3-.4 7.4 1.2 9.8.8 1.2 1.8 2.5 3.1 2.4 1.2 0 1.7-.8 3.2-.8 1.5 0 1.9.8 3.2.8 1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8 0 0-2.6-1-2.7-3.9zM14 5.6c.7-.8 1.1-1.9 1-3.1-1 0-2.2.7-2.9 1.5-.6.7-1.2 1.9-1 3 1.1.1 2.2-.6 2.9-1.4z"
    ></path>
  </svg>
  <span class="text-left leading-tight">
    <span class="type-micro block text-muted">Download on the</span>
    <span class="block font-medium text-text">App Store</span>
  </span>
</a>
