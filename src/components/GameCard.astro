---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import badgeLive from '../assets/badges/badge-live.png';
import badgeSoon from '../assets/badges/badge-soon.png';

interface Props {
  game: CollectionEntry<'games'>;
}
const { game } = Astro.props;
const { title, hook, tags, keyArt, appIcon, comingSoon } = game.data;
// Neon status sign in the corner: live on the App Store, or coming soon.
const badge = comingSoon ? { src: badgeSoon, alt: 'Coming soon' } : { src: badgeLive, alt: 'Live now on the App Store' };
---

<a href={`/games/${game.id}`} class="card group relative block overflow-hidden">
  <Image
    src={badge.src}
    alt={badge.alt}
    widths={[160, 320, 480]}
    sizes="(min-width: 768px) 176px, 136px"
    class="pointer-events-none absolute left-3 top-3 z-10 h-auto w-34 drop-shadow-lg md:left-4 md:top-4 md:w-44"
  />
  <Image
    src={keyArt.src}
    alt={keyArt.alt}
    widths={[640, 960, 1280]}
    sizes="(min-width: 768px) 50vw, 100vw"
    class="aspect-video w-full object-contain p-4"
  />
  <div class="flex items-center gap-6 p-6 md:p-8">
    <div class="min-w-0 flex-1">
      <h3 class="type-subsection text-text">{title}</h3>
      <p class="mt-2 text-muted">{hook}</p>
      <ul class="mt-6 flex flex-wrap gap-2" aria-label="Genre, platform, and price">
        <li class="tag">{tags.genre}</li>
        <li class="tag">{tags.platform}</li>
        <li class="tag">{tags.price}</li>
      </ul>
    </div>
    {appIcon && (
      <Image
        src={appIcon.src}
        alt=""
        aria-hidden="true"
        widths={[64, 128, 192]}
        sizes="(min-width: 768px) 72px, 56px"
        width={72}
        height={72}
        class="size-14 shrink-0 rounded-[22%] shadow-lg md:size-18"
      />
    )}
  </div>
</a>
