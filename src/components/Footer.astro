---
import { supportHref, privacyHref, termsHref } from '../lib/gameLinks';
import { getCollection } from 'astro:content';
import LogoMonogram from './LogoMonogram.astro';

const games = (await getCollection('games', (g) => !g.data.hidden)).sort(
  (a, b) => a.data.order - b.data.order,
);
const year = new Date().getFullYear();
---

<footer class="border-t border-hairline">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <LogoMonogram size={40} topFill="#201B2E" class="rounded-[6px] ring-1 ring-white/10" />
        <p class="type-caption mt-4 max-w-[28ch] text-muted">
          iOS games made by a tiny team in Los Angeles, on the night shift.
        </p>
      </div>

      {
        games.map((game) => (
          <div>
            <h2 class="type-label text-text">{game.data.title}</h2>
            <ul class="mt-4 space-y-2">
              <li>
                <a class="type-caption text-muted hover:text-text" href={`/games/${game.id}`}>
                  Game page
                </a>
              </li>
              <li>
                <a class="type-caption text-muted hover:text-text" href={supportHref(game)}>
                  Support
                </a>
              </li>
              <li>
                <a class="type-caption text-muted hover:text-text" href={privacyHref(game)}>
                  Privacy
                </a>
              </li>
              {termsHref(game) && (
                <li>
                  <a class="type-caption text-muted hover:text-text" href={termsHref(game)}>
                    Terms
                  </a>
                </li>
              )}
            </ul>
          </div>
        ))
      }

      <div>
        <h2 class="type-label text-text">Studio</h2>
        <ul class="mt-4 space-y-2">
          <li><a class="type-caption text-muted hover:text-text" href="/about">About</a></li>
          <li><a class="type-caption text-muted hover:text-text" href="/privacy">Site privacy</a></li>
          <li>
            <a class="type-caption text-muted hover:text-text" href="mailto:info@nattskiftgames.com">
              info@nattskiftgames.com
            </a>
          </li>
          <li>
            <a
              class="type-caption text-muted hover:text-text"
              href="https://bsky.app/profile/nattskift.bsky.social"
              rel="me noopener"
            >
              Bluesky
            </a>
          </li>
        </ul>
      </div>
    </div>

    <p class="type-micro mt-16 text-muted">
      © {year} Pacific Front Desk LLC dba Nattskift Games.
    </p>
    <p class="type-micro mt-2 flex items-center gap-1.5 text-muted">
      Made with
      {/* Hand-drawn heart - no icon package, no emoji. */}
      <svg
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="currentColor"
        role="img"
        aria-label="love"
        class="text-royal-light"
      >
        <path
          d="M12 21C12 21 3 14.5 3 8.8C3 5.6 5.5 3.5 8.2 3.5C10 3.5 11.3 4.5 12 5.6C12.7 4.5 14 3.5 15.8 3.5C18.5 3.5 21 5.6 21 8.8C21 14.5 12 21 12 21Z"
        ></path>
      </svg>
      in Los Angeles.
    </p>
  </div>
</footer>
