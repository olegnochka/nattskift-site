---
/**
 * Monogram fallback: split square, white N on the ink half, royal half empty.
 * Used anywhere the mark renders under 48px — favicons, avatars.
 * Single source of truth is src/assets/brand/monogram.svg (also consumed by
 * the favicon/OG build scripts); this component inlines it at a given size.
 */
import monogram from '../assets/brand/monogram.svg?raw';

interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className } = Astro.props;
const svg = monogram.replace(
  '<svg ',
  `<svg width="${size}" height="${size}" ${className ? `class="${className}" ` : ''}`,
);
---

<Fragment set:html={svg} />
