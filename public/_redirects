# Netlify domain aliases serve content instead of redirecting; force every
# alternate domain to 301 to the primary so one URL exists per page.
https://nattskift.games/* https://nattskiftgames.com/:splat 301!
https://www.nattskift.games/* https://nattskiftgames.com/:splat 301!
https://nattskiftgames.store/* https://nattskiftgames.com/:splat 301!
https://www.nattskiftgames.store/* https://nattskiftgames.com/:splat 301!
https://nattskiftgames.studio/* https://nattskiftgames.com/:splat 301!
https://www.nattskiftgames.studio/* https://nattskiftgames.com/:splat 301!
https://nattskift.netlify.app/* https://nattskiftgames.com/:splat 301!

# The press page was removed.
/press /games 301
/press/* /games 301

# Hunch is hidden from this site; old links go to the games list.
/games/hunch /games 301
/games/hunch/* /games 301

# Last Light and Trash Games Factory are hidden; old links go to the games list.
/games/last-light /games 301
/games/last-light/* /games 301
/games/trash-games-factory /games 301
/games/trash-games-factory/* /games 301

# Notes are hidden; old links go home.
/notes / 301
/notes/* / 301

# Short tracking links: nattskiftgames.com/go/<app>/<source> -> the App Store with a campaign token,
# so App Analytics > Acquisition > Campaigns shows downloads per source (ct). pt = provider token of
# the Nattskift account (same as in src/components/AppStoreBadge.astro). Any ending works, e.g.
# /go/latlas/reddit-geoguessr. Keep ct under 40 chars, lowercase, hyphens.
/go/latlas/:ct https://apps.apple.com/app/apple-store/id6812973799?pt=129294312&ct=:ct&mt=8 302
/go/latlas https://apps.apple.com/app/apple-store/id6812973799?pt=129294312&ct=go&mt=8 302
/go/relic-run/:ct https://apps.apple.com/app/apple-store/id6811707026?pt=129294312&ct=:ct&mt=8 302
/go/relic-run https://apps.apple.com/app/apple-store/id6811707026?pt=129294312&ct=go&mt=8 302
